{
  "name": "agverse-fullstack",
  "version": "1.0.0",
  "description": "AGverse - The Intelligence of the Earth (React + Laravel)",
  "scripts": {
    "dev": "node dev.js",
    "dev:backend": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "lint:design": "impeccable detect client/src",
    "install:all": "npm install --prefix client && composer install --working-dir=backend",
    "start": "php backend/artisan serve --host=127.0.0.1 --port=8000"
  },
  "keywords": [
    "agverse",
    "react",
    "laravel",
    "php",
    "agriculture",
    "tailwind"
  ],
  "author": "",
  "license": "ISC"
}
